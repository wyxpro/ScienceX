PORT=8787
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Sophnet DeepSeek V4.1 Flash (DeepSeek-Flash) 模型配置
DEEPSEEK_BASE_URL=https://www.sophnet.com/api/open-apis/v1
DEEPSEEK_API_KEY=your_deepseek_flash_api_key_here
DEEPSEEK_MODEL=DeepSeek-Flash

# 配置后启用真实 OpenAI 兼容模型调用；未配置时使用本地演示回退。
OPENAI_BASE_URL=https://www.sophnet.com/api/open-apis/v1
OPENAI_API_KEY=
OPENAI_MODEL=DeepSeek-Flash
# 用于加密自定义模型密钥，生产环境必须替换为高熵随机值。
SCIENCEX_MASTER_KEY=replace-with-a-long-random-secret

# 生图网关（OpenAI 兼容 /v1/images/generations），用于数据图表/科研图真实渲染。
# 留空时 Implement 阶段降级为矢量 spec 渲染。
IMAGE_BASE_URL=https://api.openai-next.com/v1
IMAGE_API_KEY=
IMAGE_MODEL=gpt-image-2
# 生图耗时较长（约 60s/张），超时按毫秒配置。
IMAGE_TIMEOUT_MS=180000

# OpenAI Next 统一文本网关（OpenAI 兼容 /v1/chat/completions，同一套 SDK 接入多厂商模型）。
# 内置模型 GPT-6.1 Sol / Claude Sonnet 5 / Gemini 3.8 Flash / DeepSeek V4 Pro / Kimi K2.5 依赖此密钥；
# 留空时这些内置模型自动降级为演示模板回退。
OPENAINEXT_BASE_URL=https://api.openai-next.com/v1
OPENAINEXT_API_KEY=

# AI 请求：单次尝试含响应体读取的超时；最多额外重试 2 次（429/408/5xx/网络故障）。
OPENAI_TIMEOUT_MS=30000
AI_RETRIES=2
AI_RETRY_BASE_MS=300
AI_CIRCUIT_FAILURES=3
AI_CIRCUIT_COOLDOWN_MS=30000

# RAG 使用独立的 OpenAI 兼容 Embedding 服务，Base URL 应包含 /v1。
# 留空会显式降级为关键词检索；本地 BGE 服务须提供 /embeddings 兼容接口。
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
# 启用后使用当前所选模型重排检索片段，会产生额外模型调用。
RAG_RERANK=false
MEMORY_MAX_FACTS=100

# 价格按每百万 Token 的人民币金额配置，键必须匹配上游返回的模型名。
# 未配置的模型显示费用未知；下面仅说明格式，请按服务商实际价格填写：
# AI_PRICES_JSON={"模型名":{"input":1,"output":2,"currency":"CNY"}}
AI_PRICES_JSON={}

# 真实文献源：arXiv 无需密钥；其他服务按服务商要求配置密钥/配额。
OPENALEX_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
# 可选，提高验证论文 GitHub 代码仓库链接时的 API 配额。
GITHUB_TOKEN=

# 生产环境允许访问的本地模型地址，逗号分隔且必须与账户模型 Base URL 完全一致。
# Ollama 使用原生 /api/chat，Base URL 不加 /v1；仅列出受信任的部署地址。
OLLAMA_ALLOWED_BASE_URLS=
# 示例：OLLAMA_ALLOWED_BASE_URLS=http://127.0.0.1:11434

