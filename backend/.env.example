# 配置后启用真实 OpenAI 兼容模型调用；未配置时使用本地演示回退。
OPENAI_BASE_URL=https://www.sophnet.com/api/open-apis/v1
OPENAI_API_KEY=
OPENAI_MODEL=DeepSeek-Flash
# 用于加密自定义模型密钥，生产环境必须替换为高熵随机值。
SCIENCEX_MASTER_KEY=replace-with-a-long-random-secret

