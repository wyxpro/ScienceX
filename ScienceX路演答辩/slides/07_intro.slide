<Slide style={{ padding: 0, background: '#F6F4EE' }}>
  <Box style={{ flexDirection: 'row', alignItems: 'center', padding: '20px 60px 8px', gap: 14 }}>
    <Box style={{ width: 4, height: 40, background: '#1B7A5E', borderRadius: 2 }} />
    <Box style={{ flex: 1 }}>
      <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
        <Box style={{ background: '#1B7A5E', borderRadius: 4, padding: '3px 10px' }}><Text style={{ fontSize: 12, color: '#FFFFFF', fontWeight: 600 }}>PART 02 · 项目简介</Text></Box>
        <Text style={{ fontSize: 13, color: '#8A948D' }}>名称 · 定位 · 价值</Text>
      </Box>
      <Text style={{ fontSize: 28, fontWeight: 'bold', color: '#1F2A26', fontFamily: 'Noto Serif SC, Georgia, serif', marginTop: 6 }}>一个覆盖科研全流程的 AI 工作台</Text>
    </Box>
    <Box style={{ background: '#E3F1EA', borderRadius: 8, padding: '8px 14px', border: '1px solid #CDE4D8' }}>
      <Text style={{ fontSize: 12, color: '#1B7A5E', fontWeight: 700, fontFamily: 'Consolas, monospace' }}>13 模块 · 40+ API · 8 类 Agent</Text>
    </Box>
  </Box>
  <Box style={{ padding: '4px 60px 0', height: 470, gap: 16 }}>
    <Text style={{ fontSize: 15.5, color: '#4A554F', lineHeight: 1.6 }}>把重复、琐碎、耗时的环节交给 AI 智能体，让研究者专注创新本身——<span style={{ fontWeight: 'bold', color: '#1B7A5E' }}>数据在各环节间无缝流转，杜绝信息孤岛</span>。</Text>
    {/* 三列价值卡 */}
    <Box style={{ flexDirection: 'row', gap: 20 }}>
      {[
        { ic: 'sync-alt', t: '全流程闭环', d: '数据在选题→文献→复现→实验→分析→写作→投稿→协作间无缝流转', c: '#1B7A5E' },
        { ic: 'plug', t: '模型中立', d: '内置 DeepSeek V4.1 Flash，支持接入任意 OpenAI 兼容大模型与 MCP 工具', c: '#4A5568' },
        { ic: 'users', t: '智能体协同', d: '8 类 Agent 编排 + 三层课题组记忆引擎，首创五角色专家评审团机制', c: '#C2762B' },
      ].map((v, i) => (
        <Box key={i} style={{ flex: 1, background: '#FFFFFF', borderRadius: 12, border: '1px solid #E6E2D6', boxShadow: '0 2px 12px rgba(0,0,0,0.06)', padding: '16px 18px', borderTop: `4px solid ${v.c}` }}>
          <Box style={{ width: 42, height: 42, borderRadius: 10, background: v.c + '16', justifyContent: 'center', alignItems: 'center', marginBottom: 10 }}>
            <FAIcon name={v.ic} style={{ fill: v.c, width: 20, height: 20 }} />
          </Box>
          <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#1F2A26', fontFamily: 'Noto Serif SC, Georgia, serif', marginBottom: 6 }}>{v.t}</Text>
          <Text style={{ fontSize: 13, color: '#4A554F', lineHeight: 1.6 }}>{v.d}</Text>
        </Box>
      ))}
    </Box>
    {/* 底部流程链条 */}
    <Box style={{ background: '#FFFFFF', borderRadius: 12, border: '1px solid #E6E2D6', padding: '18px 20px', boxShadow: '0 2px 12px rgba(0,0,0,0.06)' }}>
      <Text style={{ fontSize: 13, color: '#8A948D', marginBottom: 12, fontWeight: 600 }}>全流程闭环 · 数据自动沉淀到「我的项目」空间</Text>
      <Box style={{ flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
        {[
          { t: '选题', ic: 'lightbulb' }, { t: '文献', ic: 'book' }, { t: '复现', ic: 'redo' }, { t: '实验', ic: 'flask' },
          { t: '分析', ic: 'chart-bar' }, { t: '写作', ic: 'pen' }, { t: '投稿', ic: 'paper-plane' }, { t: '协作', ic: 'users' },
        ].map((s, i) => (
          <Box key={i} style={{ flexDirection: 'row', alignItems: 'center' }}>
            <Box style={{ flexDirection: 'column', alignItems: 'center', gap: 6 }}>
              <Box style={{ width: 52, height: 52, borderRadius: '50%', background: i === 7 ? '#1B7A5E' : '#E3F1EA', justifyContent: 'center', alignItems: 'center' }}>
                <FAIcon name={s.ic} style={{ fill: i === 7 ? '#FFFFFF' : '#1B7A5E', width: 22, height: 22 }} />
              </Box>
              <Text style={{ fontSize: 13, color: '#1F2A26', fontWeight: 600 }}>{s.t}</Text>
            </Box>
            {i < 7 && <Box style={{ width: 30, height: 2, background: '#1B7A5E', opacity: 0.5, margin: '0 4px', marginBottom: 22 }} />}
          </Box>
        ))}
      </Box>
    </Box>
  </Box>
  <Box style={{ flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center', padding: '0 60px', height: 40, marginTop: 6 }}>
    <Text style={{ fontSize: 12, color: '#8A948D' }}>ScienceX · AI 科研工作台</Text>
    <Text style={{ fontSize: 12, color: '#8A948D' }}>07 / 22</Text>
  </Box>
</Slide>
