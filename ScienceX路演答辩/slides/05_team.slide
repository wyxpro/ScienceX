<Slide style={{ padding: 0, background: '#F6F4EE' }}>
  {/* A 标题块 */}
  <Box style={{ flexDirection: 'row', alignItems: 'center', padding: '20px 60px 8px', gap: 14 }}>
    <Box style={{ width: 4, height: 40, background: '#1B7A5E', borderRadius: 2 }} />
    <Box>
      <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
        <Box style={{ background: '#1B7A5E', borderRadius: 4, padding: '3px 10px' }}><Text style={{ fontSize: 12, color: '#FFFFFF', fontWeight: 600 }}>PART 02 · 团队及产品</Text></Box>
        <Text style={{ fontSize: 13, color: '#8A948D' }}>产品 × 工程 × 算法三线并置</Text>
      </Box>
      <Text style={{ fontSize: 28, fontWeight: 'bold', color: '#1F2A26', fontFamily: 'Noto Serif SC, Georgia, serif', marginTop: 6 }}>一支「懂科研」的跨学科团队</Text>
    </Box>
  </Box>
  {/* B 内容区 */}
  <Box style={{ padding: '6px 60px 0', height: 470 }}>
    <Box style={{ flexDirection: 'row', gap: 24, height: 372, alignItems: 'flex-end', paddingTop: 20 }}>
      {[
        { role: '产品负责人', name: '张 ××', ic: 'user-tie', bar: '#1B7A5E', lift: false, items: ['前沿科研一线经历', '13 大功能模块 · 全流程 PRD 设计', '用户画像与场景深度调研', '定价与商业模式设计'] },
        { role: '全栈开发工程师', name: '李 ××', ic: 'code', bar: '#4A5568', lift: false, items: ['React 18 + TypeScript 前端', 'Node.js + Express 后端', '40+ REST/SSE 接口契约设计', 'HMAC 安全认证与限流治理'] },
        { role: 'Agent 算法工程师', name: '王 ××', ic: 'robot', bar: '#C2762B', lift: true, items: ['灵犀多智能体引擎 · 8 类编排', '三层课题组记忆引擎', 'RAG 检索与提示词工程体系', '五角色专家评审团机制'] },
      ].map((m, i) => (
        <Box key={i} style={{ flex: 1, height: m.lift ? '100%' : '90%', background: '#FFFFFF', borderRadius: 14, border: m.lift ? '2px solid #C2762B' : '1px solid #E6E2D6', boxShadow: m.lift ? '0 8px 28px rgba(194,118,43,0.14)' : '0 2px 12px rgba(0,0,0,0.06)', padding: '20px 20px 16px', flexDirection: 'column', gap: 12 }}>
          <Box style={{ height: 5, background: m.bar, borderRadius: 3, margin: '-20px -20px 0', borderTopLeftRadius: 14, borderTopRightRadius: 14 }} />
          <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 14 }}>
            <Box style={{ width: 60, height: 60, borderRadius: '50%', background: m.bar + '18', justifyContent: 'center', alignItems: 'center' }}>
              <FAIcon name={m.ic} style={{ fill: m.bar, width: 26, height: 26 }} />
            </Box>
            <Box>
              <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#1F2A26', fontFamily: 'Noto Serif SC, Georgia, serif' }}>{m.name}</Text>
              <Box style={{ background: '#E3F1EA', borderRadius: 10, padding: '2px 10px', marginTop: 4, alignSelf: 'flex-start' }}><Text style={{ fontSize: 12, color: '#1B7A5E', fontWeight: 600 }}>{m.role}</Text></Box>
            </Box>
          </Box>
          <Box style={{ borderTop: '1px solid #EFECE2', paddingTop: 10, gap: 8, flexDirection: 'column' }}>
            {m.items.map((it, j) => (
              <Box key={j} style={{ flexDirection: 'row', gap: 8, alignItems: 'flex-start' }}>
                <FAIcon name="check-circle" style={{ fill: m.bar, width: 14, height: 14 }} />
                <Text style={{ fontSize: 13.5, color: '#4A554F', lineHeight: 1.5 }}>{it}</Text>
              </Box>
            ))}
          </Box>
        </Box>
      ))}
    </Box>
    <Box style={{ flexDirection: 'row', alignItems: 'center', marginTop: 16, padding: '12px 18px', background: '#E3F1EA', borderLeft: '4px solid #1B7A5E', borderRadius: 6, gap: 12 }}>
      <FAIcon name="quote-left" style={{ fill: '#1B7A5E', width: 18, height: 18 }} />
      <Text style={{ fontSize: 14.5, color: '#1F2A26', lineHeight: 1.6 }}>我们不只是「给科研做软件的人」，我们本身就是科研流程的亲历者——每一个功能，都来自一次真实的深夜改稿与组会汇报。</Text>
    </Box>
  </Box>
  {/* C 页脚条 */}
  <Box style={{ flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center', padding: '0 60px', height: 40, marginTop: 6 }}>
    <Text style={{ fontSize: 12, color: '#8A948D' }}>ScienceX · AI 科研工作台</Text>
    <Text style={{ fontSize: 12, color: '#8A948D' }}>05 / 22</Text>
  </Box>
</Slide>
