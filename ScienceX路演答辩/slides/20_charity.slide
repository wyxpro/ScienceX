<Slide style={{ padding: 0, background: '#F6F4EE' }}>
  <Box style={{ flexDirection: 'row', alignItems: 'center', padding: '18px 60px 6px', gap: 14 }}>
    <Box style={{ width: 4, height: 40, background: '#1B7A5E', borderRadius: 2 }} />
    <Box>
      <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
        <Box style={{ background: '#C2762B', borderRadius: 4, padding: '3px 10px' }}><Text style={{ fontSize: 12, color: '#FFFFFF', fontWeight: 600 }}>PART 04 · 公益计划</Text></Box>
        <Text style={{ fontSize: 13, color: '#8A948D' }}>科研公平 · 四级阶梯</Text>
      </Box>
      <Text style={{ fontSize: 26, fontWeight: 'bold', color: '#1F2A26', fontFamily: 'Noto Serif SC, Georgia, serif', marginTop: 4 }}>让科研的光，照到每一张书桌</Text>
    </Box>
  </Box>
  <Box style={{ padding: '4px 60px 0', height: 446, flexDirection: 'column', gap: 0 }}>
    {/* 四步阶梯（逐级抬升） */}
    <Box style={{ flexDirection: 'row', gap: 16, alignItems: 'flex-end', flex: 1 }}>
      {[
        { n: '①', ic: 'unlock', t: '免费开放基础能力', items: ['对中西部高校与欠发达地区院校', '捐赠课题组版一学年使用权', '保留完整数据私有可控承诺'], h: 176, c: '#D2E8DC', t: '#0E4A37' },
        { n: '②', ic: 'university', t: '高校公益版', items: ['青年教师 / 博后科研启动期免费升级 Pro', '首届本科生毕业论文公益陪跑计划', '学术导师 1v1 润色辅导'], h: 224, c: '#BBDCCB', t: '#0E4A37' },
        { n: '③', ic: 'user-graduate', t: '青年学者扶持', items: ['青年教师 / 博后免费升级 Pro', '首届本科生毕业论文公益陪跑', '学术导师 1v1 润色辅导'], h: 272, c: '#9CC9B4', t: '#0E4A37' },
        { n: '④', ic: 'hands-helping', t: '开源生态共建', items: ['核心技能市场开源', '高校科研 Agent 插件共创大赛', '与开源社区共建学术 MCP 工具生态', 'DreamPaper 复现模板开源共建'], h: 330, c: '#1B7A5E', t: '#FFFFFF' },
      ].map((s, i) => (
        <Box key={i} style={{ flex: 1, height: s.h, background: s.c, borderRadius: 12, padding: '14px 14px', flexDirection: 'column', gap: 6, border: '1px solid rgba(0,0,0,0.05)' }}>
          <Text style={{ fontSize: 22, fontWeight: 'bold', color: s.t === '#FFFFFF' ? '#F0C419' : '#C2762B', fontFamily: 'Noto Serif SC, Georgia, serif' }}>{s.n}</Text>
          <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 6 }}>
            <FAIcon name={s.ic} style={{ fill: s.t === '#FFFFFF' ? '#FFFFFF' : '#1B7A5E', width: 16, height: 16 }} />
            <Text style={{ fontSize: 14.5, fontWeight: 'bold', color: s.t, fontFamily: 'Noto Serif SC, Georgia, serif' }}>{s.t}</Text>
          </Box>
          <Box style={{ flexDirection: 'column', gap: 4 }}>
            {s.items.map((it, j) => (
              <Box key={j} style={{ flexDirection: 'row', gap: 5, alignItems: 'flex-start' }}>
                <Box style={{ width: 4, height: 4, borderRadius: '50%', background: s.t === '#FFFFFF' ? 'rgba(255,255,255,0.7)' : '#1B7A5E', marginTop: 5, flexShrink: 0 }} />
                <Text style={{ fontSize: 10.8, color: s.t, lineHeight: 1.45, opacity: s.t === '#FFFFFF' ? 0.9 : 1 }}>{it}</Text>
              </Box>
            ))}
          </Box>
        </Box>
      ))}
    </Box>
    {/* 愿景金句 */}
    <Box style={{ background: '#0E4A37', borderRadius: 12, padding: '14px 24px', marginTop: 16, alignItems: 'center' }}>
      <Text style={{ fontSize: 17, color: '#FFFFFF', fontFamily: 'Noto Serif SC, Georgia, serif', lineHeight: 1.6, textAlign: 'center' }}>
        「科研的起点不应由资源决定。我们希望让每一个怀揣好奇心的人，<br />都拥有一支随叫随到的 <span style={{ color: '#F0C419', fontWeight: 'bold' }}>AI 科研助理团</span>。」
      </Text>
    </Box>
  </Box>
  <Box style={{ flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center', padding: '0 60px', height: 38, marginTop: 4 }}>
    <Text style={{ fontSize: 12, color: '#8A948D' }}>ScienceX · AI 科研工作台</Text>
    <Text style={{ fontSize: 12, color: '#8A948D' }}>20 / 22</Text>
  </Box>
</Slide>
