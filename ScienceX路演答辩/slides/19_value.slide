<Slide style={{ padding: 0, background: '#F6F4EE' }}>
  <Box style={{ flexDirection: 'row', alignItems: 'center', padding: '18px 60px 6px', gap: 14 }}>
    <Box style={{ width: 4, height: 40, background: '#1B7A5E', borderRadius: 2 }} />
    <Box>
      <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
        <Box style={{ background: '#1B7A5E', borderRadius: 4, padding: '3px 10px' }}><Text style={{ fontSize: 12, color: '#FFFFFF', fontWeight: 600 }}>PART 04 · 行业落地价值</Text></Box>
        <Text style={{ fontSize: 13, color: '#8A948D' }}>效率提升 · 测试用户数据</Text>
      </Box>
      <Text style={{ fontSize: 27, fontWeight: 'bold', color: '#1F2A26', fontFamily: 'Noto Serif SC, Georgia, serif', marginTop: 4 }}>8 位学者实测：论文产出周期目标缩短 50%+</Text>
    </Box>
  </Box>
  <Box style={{ padding: '4px 60px 0', height: 478, flexDirection: 'column', gap: 12 }}>
    {/* 上段：五大行业价值 */}
    <Box style={{ flexDirection: 'row', gap: 12 }}>
      {[
        { ic: 'bolt', t: '科研效率', d: '缩短选题到投稿周期 · 提升人均产出' },
        { ic: 'balance-scale', t: '科研公平', d: '小团队/欠发达地区也有「AI 助理团」' },
        { ic: 'book', t: '知识沉淀', d: '课题组知识资产化 · 可传承可复用' },
        { ic: 'industry', t: '产业转化', d: '加速企业技术调研与成果落地' },
        { ic: 'graduation-cap', t: '教育价值', d: '帮助研究生系统学习科研方法论' },
      ].map((v, i) => (
        <Box key={i} style={{ flex: 1, background: '#FFFFFF', borderRadius: 10, border: '1px solid #E6E2D6', padding: '10px 8px', alignItems: 'center', gap: 5 }}>
          <FAIcon name={v.ic} style={{ fill: '#1B7A5E', width: 20, height: 20 }} />
          <Text style={{ fontSize: 13, fontWeight: 'bold', color: '#1F2A26', textAlign: 'center' }}>{v.t}</Text>
          <Text style={{ fontSize: 9.8, color: '#8A948D', textAlign: 'center', lineHeight: 1.35 }}>{v.d}</Text>
        </Box>
      ))}
    </Box>
    {/* 下段：左条形图 + 右用户数据卡 */}
    <Box style={{ flexDirection: 'row', gap: 20, flex: 1 }}>
      <Box style={{ flex: 1.35, background: '#FFFFFF', borderRadius: 12, border: '1px solid #E6E2D6', padding: '12px 16px', boxShadow: '0 2px 10px rgba(0,0,0,0.05)', flexDirection: 'column' }}>
        <Text style={{ fontSize: 14.5, fontWeight: 'bold', color: '#1F2A26', fontFamily: 'Noto Serif SC, Georgia, serif', marginBottom: 6 }}>效率提升实测（↓ 耗时降低 / ↑ 效率提升）</Text>
        <Chart
          style={{ flex: 1, minHeight: 300 }}
          chartType="barChart"
          barDirection="bar"
          grouping="clustered"
          showLegend={false}
          showDataLabels={true}
          legendColor="#8A948D"
          axisColor="#8A948D"
          dataLabelColor="#0E4A37"
          colors={['#1B7A5E']}
          background="#FFFFFF"
          data={[
            ['指标', '提升幅度 %'],
            ['选题调研耗时', 60],
            ['单篇精读耗时', 50],
            ['数据出图+解读耗时', 70],
            ['组会准备耗时', 70],
            ['实验方案设计效率', 40],
            ['论文改稿轮次', 50],
            ['投稿准备耗时', 40],
          ]}
        />
      </Box>
      <Box style={{ flex: 1, background: '#F0F7F3', borderRadius: 12, border: '1px solid #CDE4D8', padding: '14px 16px', flexDirection: 'column', gap: 8 }}>
        <Text style={{ fontSize: 14.5, fontWeight: 'bold', color: '#0E4A37', fontFamily: 'Noto Serif SC, Georgia, serif' }}>测试用户数据（8 位真实学者）</Text>
        <Box style={{ flexDirection: 'column', gap: 5 }}>
          <Text style={{ fontSize: 12.5, color: '#234038', lineHeight: 1.55 }}>👨‍🎓 <span style={{ fontWeight: 'bold' }}>构成：</span>博士生 4 位 · 硕士生 2 位 · 教师/PI 2 位</Text>
          <Text style={{ fontSize: 12.5, color: '#234038', lineHeight: 1.55 }}>🏛️ <span style={{ fontWeight: 'bold' }}>机构：</span>清华 · 北大 · 浙大 · 复旦 · 上交 · 中科大 · 南大 · 中科院</Text>
          <Text style={{ fontSize: 12.5, color: '#234038', lineHeight: 1.55 }}>📊 <span style={{ fontWeight: 'bold' }}>口碑评分：</span><span style={{ color: '#C2762B', fontWeight: 'bold' }}>5.0 / 5.0（全五星）</span></Text>
        </Box>
        <Box style={{ background: '#FFFFFF', borderRadius: 8, padding: '8px 12px', borderLeft: '3px solid #1B7A5E' }}>
          <Text style={{ fontSize: 11.5, color: '#4A554F', lineHeight: 1.6 }}>💬 「节省整整两周摸索时间」「查出了标注误差」「避免大修拒稿风险」「实验资产 100% 数字化沉淀」</Text>
        </Box>
        <Box style={{ marginTop: 'auto', background: '#1B7A5E', borderRadius: 8, padding: '8px 12px', flexDirection: 'row', alignItems: 'center', gap: 8 }}>
          <FAIcon name="rocket" style={{ fill: '#FFFFFF', width: 15, height: 15 }} />
          <Text style={{ fontSize: 12.5, color: '#FFFFFF', fontWeight: 'bold' }}>论文产出周期目标：平均缩短 50% 以上</Text>
        </Box>
      </Box>
    </Box>
  </Box>
  <Box style={{ flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center', padding: '0 60px', height: 38, marginTop: 2 }}>
    <Text style={{ fontSize: 12, color: '#8A948D' }}>ScienceX · AI 科研工作台</Text>
    <Text style={{ fontSize: 12, color: '#8A948D' }}>19 / 22</Text>
  </Box>
</Slide>
