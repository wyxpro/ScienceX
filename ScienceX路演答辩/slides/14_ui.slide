<Slide style={{ padding: 0, background: '#F6F4EE' }}>
  <Box style={{ flexDirection: 'row', alignItems: 'center', padding: '18px 60px 6px', gap: 14 }}>
    <Box style={{ width: 4, height: 40, background: '#1B7A5E', borderRadius: 2 }} />
    <Box>
      <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
        <Box style={{ background: '#1B7A5E', borderRadius: 4, padding: '3px 10px' }}><Text style={{ fontSize: 12, color: '#FFFFFF', fontWeight: 600 }}>PART 03 · UI 设计</Text></Box>
        <Text style={{ fontSize: 13, color: '#8A948D' }}>前端 / 可视化 · Nature 期刊装帧美学</Text>
      </Box>
      <Text style={{ fontSize: 27, fontWeight: 'bold', color: '#1F2A26', fontFamily: 'Noto Serif SC, Georgia, serif', marginTop: 4 }}>学术暖纸质感 × 现代极简数字工作台</Text>
    </Box>
  </Box>
  <Box style={{ flexDirection: 'row', padding: '4px 60px 0', height: 478, gap: 26 }}>
    {/* 左：设计理念五要点 */}
    <Box style={{ flex: 1.2, flexDirection: 'column', gap: 10 }}>
      {[
        { ic: 'palette', t: '拒绝廉价 AI 蓝紫渐变', d: '象牙暖纸底 #F6F4EE × 深墨绿 #1B7A5E，Nature 期刊装帧美学；长时间阅读无蓝光疲劳，WCAG 2.1 AA/AAA 无障碍对比度。', c: '#1B7A5E' },
        { ic: 'font', t: '学术级字体三元组', d: '衬线标题（权威感）+ 无衬线正文（现代感）+ 等宽数据（严谨感）。', c: '#4A5568' },
        { ic: 'cube', t: '高端材质语言', d: '玻璃拟态弹层 · 微羽化环境光晕 · 亚像素边框 · 卡片三级高程投影。', c: '#C2762B' },
        { ic: 'ruler-combined', t: '8pt 栅格 + 四级响应式断点', d: '1440 超宽 / 1025 桌面 / 769 平板 / ≤768 移动——九大界面移动端全面适配，弹窗自动下沉为 Bottom Sheet。', c: '#1B7A5E' },
        { ic: 'magic', t: '物理微动效', d: '学者曲线缓动 cubic-bezier(0.22,0.8,0.32,1) · 列表瀑布式交错入场 · AI 打字机墨绿光标 · prefers-reduced-motion 无障碍降级。', c: '#4A5568' },
      ].map((p, i) => (
        <Box key={i} style={{ background: '#FFFFFF', borderRadius: 10, border: '1px solid #EFECE2', borderLeft: `4px solid ${p.c}`, padding: '9px 14px', boxShadow: '0 1px 8px rgba(0,0,0,0.04)' }}>
          <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 8 }}>
            <FAIcon name={p.ic} style={{ fill: p.c, width: 16, height: 16 }} />
            <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#1F2A26' }}>{p.t}</Text>
          </Box>
          <Text style={{ fontSize: 12, color: '#4A554F', lineHeight: 1.55, marginTop: 3 }}>{p.d}</Text>
        </Box>
      ))}
    </Box>
    {/* 右：可视化亮点卡 */}
    <Box style={{ flex: 1, flexDirection: 'column', gap: 12 }}>
      <Box style={{ background: '#FFFFFF', borderRadius: 12, border: '1px solid #E6E2D6', padding: '16px 18px', boxShadow: '0 2px 10px rgba(0,0,0,0.05)', flex: 1 }}>
        <Text style={{ fontSize: 15.5, fontWeight: 'bold', color: '#1F2A26', fontFamily: 'Noto Serif SC, Georgia, serif', marginBottom: 10 }}>自研 Dynamic SVG 图表引擎</Text>
        <Box style={{ flexDirection: 'column', gap: 8 }}>
          {[
            { t: '矢量消融柱状图', w: '88%' },
            { t: '训练收敛曲线', w: '76%' },
            { t: '混淆矩阵', w: '64%' },
            { t: 'CitationGraph3D 力导向引用星系', w: '96%' },
            { t: '五维评审雷达 · GPU 环形仪表', w: '82%' },
          ].map((b, i) => (
            <Box key={i}>
              <Text style={{ fontSize: 12, color: '#4A554F', marginBottom: 3 }}>{b.t}</Text>
              <Box style={{ height: 8, background: '#EFECE2', borderRadius: 4, overflow: 'hidden' }}>
                <Box style={{ width: b.w, height: '100%', background: `linear-gradient(90deg, #1B7A5E, ${i % 2 ? '#C2762B' : '#2FA37E'})`, borderRadius: 4 }} />
              </Box>
            </Box>
          ))}
        </Box>
      </Box>
      <Box style={{ background: '#E3F1EA', borderRadius: 12, border: '1px solid #CDE4D8', padding: '12px 16px', flexDirection: 'row', alignItems: 'center', gap: 10 }}>
        <FAIcon name="mobile-alt" style={{ fill: '#1B7A5E', width: 20, height: 20 }} />
        <Text style={{ fontSize: 13, color: '#234038', lineHeight: 1.5 }}>九大界面移动端全面适配，弹窗自动下沉为 Bottom Sheet</Text>
      </Box>
    </Box>
  </Box>
  <Box style={{ flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center', padding: '0 60px', height: 40, marginTop: 4 }}>
    <Text style={{ fontSize: 12, color: '#8A948D' }}>ScienceX · AI 科研工作台</Text>
    <Text style={{ fontSize: 12, color: '#8A948D' }}>14 / 22</Text>
  </Box>
</Slide>
