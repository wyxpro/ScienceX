<Slide style={{ padding: 0, background: '#F6F4EE' }}>
  {/* A 标题块 */}
  <Box style={{ flexDirection: 'row', alignItems: 'center', padding: '20px 60px 10px', gap: 14 }}>
    <Box style={{ width: 4, height: 40, background: '#1B7A5E', borderRadius: 2 }} />
    <Box>
      <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
        <Box style={{ background: '#1B7A5E', borderRadius: 4, padding: '3px 10px' }}><Text style={{ fontSize: 12, color: '#FFFFFF', fontWeight: 600 }}>PART 01 · 需求洞察</Text></Box>
        <Text style={{ fontSize: 13, color: '#8A948D' }}>八大痛点 · 一一对应解法</Text>
      </Box>
      <Text style={{ fontSize: 28, fontWeight: 'bold', color: '#1F2A26', fontFamily: 'Noto Serif SC, Georgia, serif', marginTop: 6 }}>科研痛点 × ScienceX 解法 —— 每条都可量化</Text>
    </Box>
  </Box>
  {/* B 内容区 */}
  <Box style={{ padding: '8px 60px 10px', height: 500 }}>
    <Table
      style={{ width: '100%', height: 412 }}
      defaultTextStyle={{ fontSize: 13.5, textAlign: 'left', color: '#1F2A26' }}
      defaultCellStyle={{
        border: { left: { width: 1, color: '#E6E2D6' }, right: { width: 1, color: '#E6E2D6' }, top: { width: 1, color: '#E6E2D6' }, bottom: { width: 1, color: '#E6E2D6' } },
      }}
      cells={[
        [
          { text: '科研环节', textStyle: { bold: true, color: '#FFFFFF', fontSize: 14 }, cellStyle: { background: { color: '#1B7A5E' } } },
          { text: '😫 真实痛点', textStyle: { bold: true, color: '#FFFFFF', fontSize: 14 }, cellStyle: { background: { color: '#B0413E' } } },
          { text: '✨ ScienceX 的解法', textStyle: { bold: true, color: '#FFFFFF', fontSize: 14 }, cellStyle: { background: { color: '#1B7A5E' } } },
          { text: '量化收益', textStyle: { bold: true, color: '#FFFFFF', fontSize: 14 }, cellStyle: { background: { color: '#C2762B' } } },
        ],
        ['选题', '不知从哪找方向、判断不了可行性', '多源文献检索 + 选题推荐 + 5 维可行性评估 + 一键开题报告', { text: '调研耗时 ↓60%', textStyle: { bold: true, color: '#C2762B' } }],
        ['读文献', '英文阅读慢、读不懂、读了忘', '划词翻译 + 思维导图 + 七段式总结 + 3D 引用图谱', { text: '单篇精读 ↓50%', textStyle: { bold: true, color: '#C2762B' } }],
        [{ text: '实验', cellStyle: { background: { color: '#F0EFE8' } } }, { text: '参数乱记、GPU 抢不到、方案拍脑袋', cellStyle: { background: { color: '#F0EFE8' } } }, { text: '参数看板 + GPU 可视化 + 消融方案矩阵 + SOTA 对标', cellStyle: { background: { color: '#F0EFE8' } } }, { text: '方案设计 ↑40%', textStyle: { bold: true, color: '#C2762B' }, cellStyle: { background: { color: '#F0EFE8' } } }],
        ['数据分析', '不会画图、看不懂结果', '10 类学术图表模板 + AI 图表解读与建议', { text: '出图解读 ↓70%', textStyle: { bold: true, color: '#C2762B' } }],
        [{ text: '写作', cellStyle: { background: { color: '#F0EFE8' } } }, { text: '表达不地道、怕查重、降重难', cellStyle: { background: { color: '#F0EFE8' } } }, { text: '中英互译 + 学术润色 + AI 查重 + 保义降重', cellStyle: { background: { color: '#F0EFE8' } } }, { text: '改稿轮次 ↓50%', textStyle: { bold: true, color: '#C2762B' }, cellStyle: { background: { color: '#F0EFE8' } } }],
        ['投稿', '不了解期刊、错过 deadline', 'CCF 期刊大全 + 投稿倒计时 + 智能匹配推荐', { text: '投稿准备 ↓40%', textStyle: { bold: true, color: '#C2762B' } }],
        [{ text: '协作', cellStyle: { background: { color: '#F0EFE8' } } }, { text: '组会汇报累、导师意见散乱', cellStyle: { background: { color: '#F0EFE8' } } }, { text: 'PPT 一键生成 + 导师建议待办化 + 多智能体评审', cellStyle: { background: { color: '#F0EFE8' } } }, { text: '组会准备 ↓70%', textStyle: { bold: true, color: '#C2762B' }, cellStyle: { background: { color: '#F0EFE8' } } }],
        ['知识', '资料散落各处、无法复用', '课题组空间 + RAG 知识库', { text: '知识复用显著提升', textStyle: { bold: true, color: '#C2762B' } }],
      ]}
    />
    {/* 底部结论条 */}
    <Box style={{ flexDirection: 'row', alignItems: 'center', marginTop: 14, padding: '12px 18px', background: '#FAF0E1', borderLeft: '4px solid #C2762B', borderRadius: 6, gap: 12 }}>
      <FAIcon name="lightbulb" style={{ fill: '#C2762B', width: 18, height: 18 }} />
      <Text style={{ fontSize: 15.5, color: '#4A3A22', lineHeight: 1.6 }}><span style={{ fontWeight: 'bold' }}>总价值主张：</span>把科研从「体力活」变成「思考活」——AI 承接 60% 以上重复劳动，让研究者把时间花在<span style={{ fontWeight: 'bold', color: '#1B7A5E' }}>提出好问题</span>上。</Text>
    </Box>
  </Box>
  {/* C 页脚条 */}
  <Box style={{ flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center', padding: '0 60px', height: 40, marginTop: 10 }}>
    <Text style={{ fontSize: 12, color: '#8A948D' }}>ScienceX · AI 科研工作台</Text>
    <Text style={{ fontSize: 12, color: '#8A948D' }}>03 / 22</Text>
  </Box>
</Slide>
