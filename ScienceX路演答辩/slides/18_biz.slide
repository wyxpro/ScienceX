<Slide style={{ padding: 0, background: '#F6F4EE' }}>
  <Box style={{ flexDirection: 'row', alignItems: 'center', padding: '18px 60px 6px', gap: 14 }}>
    <Box style={{ width: 4, height: 40, background: '#1B7A5E', borderRadius: 2 }} />
    <Box>
      <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
        <Box style={{ background: '#1B7A5E', borderRadius: 4, padding: '3px 10px' }}><Text style={{ fontSize: 12, color: '#FFFFFF', fontWeight: 600 }}>PART 04 · 商业模式</Text></Box>
        <Text style={{ fontSize: 13, color: '#8A948D' }}>成本 · 收益 · 市场 · 定价</Text>
      </Box>
      <Text style={{ fontSize: 27, fontWeight: 'bold', color: '#1F2A26', fontFamily: 'Noto Serif SC, Georgia, serif', marginTop: 4 }}>清晰的 LTV 结构：免费 → Pro → Team → 机构</Text>
    </Box>
  </Box>
  <Box style={{ padding: '4px 60px 0', height: 478, flexDirection: 'column', gap: 12 }}>
    {/* 上层三列 */}
    <Box style={{ flexDirection: 'row', gap: 16 }}>
      {[
        { ic: 'coins', t: '成本结构', c: '#C2762B', items: ['LLM 调用成本（弹性）：单轮对话 ≈ $0.015，七段总结 ≈ $0.075，综述生成 ≈ $0.005', '算力与存储（按量）', '模型路由降本：贵任务用 GPT-4o，批量任务用 Flash'] },
        { ic: 'dollar-sign', t: '收益模型', c: '#1B7A5E', items: ['订阅制（主力收入）', 'API / 算力增值服务', '企业私有化部署', '生态分成（模型/插件）', '增值：深度查重 / 评审 / 综述'] },
        { ic: 'chart-line', t: '市场空间', c: '#0E4A37', items: ['AI for Science 确定性高景气赛道', '全国在校研究生 365万+', '高校/院所/企业研发中心数十万家', '闭环平台粘性强，数据飞轮显著'] },
      ].map((c, i) => (
        <Box key={i} style={{ flex: 1, background: '#FFFFFF', borderRadius: 12, border: '1px solid #E6E2D6', padding: '12px 16px', boxShadow: '0 2px 10px rgba(0,0,0,0.05)', borderTop: `4px solid ${c.c}` }}>
          <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 8, marginBottom: 7 }}>
            <FAIcon name={c.ic} style={{ fill: c.c, width: 17, height: 17 }} />
            <Text style={{ fontSize: 16.5, fontWeight: 'bold', color: '#1F2A26', fontFamily: 'Noto Serif SC, Georgia, serif' }}>{c.t}</Text>
          </Box>
          <Box style={{ flexDirection: 'column', gap: 5 }}>
            {c.items.map((it, j) => (
              <Box key={j} style={{ flexDirection: 'row', gap: 6, alignItems: 'flex-start' }}>
                <Box style={{ width: 4, height: 4, borderRadius: '50%', background: c.c, marginTop: 6, flexShrink: 0 }} />
                <Text style={{ fontSize: 12, color: '#4A554F', lineHeight: 1.5 }}>{it}</Text>
              </Box>
            ))}
          </Box>
        </Box>
      ))}
    </Box>
    {/* 下层：四档定价阶梯 */}
    <Box style={{ flexDirection: 'row', gap: 14, flex: 1 }}>
      {[
        { t: '🌱 探索版', p: 'FREE · ¥0', s: '永久免费', items: ['30 次/日 基础对话', '5 篇/月 文献分析', '基础润色翻译'], hi: false },
        { t: '⭐ 科研进阶版', p: 'PRO · ¥19.9/月', s: '论文冲刺首选', items: ['无限对话交互', '三栏精读 + 引用图谱', '消融方案矩阵', '完整盲审 10 次/月', '查重降重 · PPTX 一键生成'], hi: true },
        { t: '👥 课题组', p: 'TEAM · ¥299/月', s: '团队共享', items: ['15 席位团队成员', '共享 RAG 知识库', 'GPU 调度', '成果看板'], hi: false },
        { t: '🏛️ 机构私有版', p: 'ENTERPRISE · 按需定制', s: '按年付费', items: ['单机/K8s 私有化部署', '本地模型集成', 'SSO + 审计', '定制 Agent'], hi: false },
      ].map((pl, i) => (
        <Box key={i} style={{ flex: 1, background: pl.hi ? '#FFF9F0' : '#FFFFFF', borderRadius: 12, border: pl.hi ? '2px solid #C2762B' : '1px solid #E6E2D6', padding: '12px 14px', position: 'relative', boxShadow: pl.hi ? '0 8px 24px rgba(194,118,43,0.14)' : '0 2px 10px rgba(0,0,0,0.05)', flexDirection: 'column', gap: 6 }}>
          {pl.hi && <Box style={{ position: 'absolute', top: 6, right: 10, background: '#C2762B', borderRadius: 10, padding: '2px 12px' }}><Text style={{ fontSize: 10.5, color: '#fff', fontWeight: 700 }}>推荐方案</Text></Box>}
          <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#1F2A26', fontFamily: 'Noto Serif SC, Georgia, serif', marginTop: 4 }}>{pl.t}</Text>
          <Text style={{ fontSize: 13.5, fontWeight: 'bold', color: pl.hi ? '#C2762B' : '#1B7A5E', fontFamily: 'Consolas, monospace' }}>{pl.p}</Text>
          <Text style={{ fontSize: 10.5, color: '#8A948D' }}>{pl.s}</Text>
          <Box style={{ flexDirection: 'column', gap: 3, marginTop: 4 }}>
            {pl.items.map((it, j) => (
              <Box key={j} style={{ flexDirection: 'row', gap: 5, alignItems: 'flex-start' }}>
                <FAIcon name="check" style={{ fill: pl.hi ? '#C2762B' : '#1B7A5E', width: 11, height: 11 }} />
                <Text style={{ fontSize: 11, color: '#4A554F', lineHeight: 1.4 }}>{it}</Text>
              </Box>
            ))}
          </Box>
        </Box>
      ))}
    </Box>
  </Box>
  <Box style={{ flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center', padding: '0 60px', height: 38, marginTop: 2 }}>
    <Text style={{ fontSize: 12, color: '#8A948D' }}>ScienceX · AI 科研工作台</Text>
    <Text style={{ fontSize: 12, color: '#8A948D' }}>18 / 22</Text>
  </Box>
</Slide>
