<Slide style={{ padding: 0, background: '#F6F4EE' }}>
  <Box style={{ flexDirection: 'row', width: '100%', height: '100%' }}>
    {/* 左侧金句区 */}
    <Box style={{ width: '58%', height: '100%', padding: '72px 32px 64px 64px', justifyContent: 'center', gap: 24, position: 'relative' }}>
      <Box style={{ position: 'absolute', top: 40, right: 20, width: 200, height: 200, borderRadius: '50%', background: '#C2762B', opacity: 0.07 }} />
      <Text style={{ fontSize: 46, fontWeight: 'bold', color: '#1F2A26', fontFamily: 'Noto Serif SC, Georgia, serif', lineHeight: 1.35 }}>
        准备好让 AI 成为你<br /><span style={{ color: '#1B7A5E' }}>终身科研协同伴侣</span>了吗？
      </Text>
      <Box style={{ background: '#1B7A5E', borderRadius: 12, padding: '14px 24px', alignSelf: 'flex-start', boxShadow: '0 6px 18px rgba(27,122,94,0.28)' }}>
        <Text style={{ fontSize: 17, color: '#FFFFFF', fontWeight: 'bold' }}>🚀 立即开启科研之旅 · 免费使用</Text>
      </Box>
      <Box style={{ flexDirection: 'column', gap: 4, marginTop: 10 }}>
        <Text style={{ fontSize: 13, color: '#8A948D' }}>演示账号：demo@sciencex.cn</Text>
        <Text style={{ fontSize: 13, color: '#8A948D' }}>让科学探索更高效，让科研创新更专注。</Text>
      </Box>
    </Box>
    {/* 右侧品牌区 */}
    <Box style={{ width: '42%', height: '100%', position: 'relative', justifyContent: 'center', alignItems: 'center', background: 'linear-gradient(160deg, #F0EDE4 0%, #E7EFEA 55%, #F5EFE3 100%)' }}>
      <Box style={{ position: 'absolute', top: 0, left: 0, width: 200, height: 200, borderRadius: '50%', background: '#1B7A5E', opacity: 0.07 }} />
      <Box style={{ alignItems: 'center', gap: 14, position: 'relative', zIndex: 1 }}>
        <Image src="assets/logo.png" style={{ width: 150, height: 150, objectFit: 'contain' }} />
        <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#1F2A26', fontFamily: 'Noto Serif SC, Georgia, serif' }}>ScienceX · AI 科研工作台</Text>
        <Text style={{ fontSize: 13, color: '#8A948D', textAlign: 'center', lineHeight: 1.7 }}>欢迎现场扫码体验<br />期待您的交流与合作</Text>
      </Box>
    </Box>
  </Box>
</Slide>
